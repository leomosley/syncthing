---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "docs";
}

const { title, description, active } = Astro.props;
const repo = "https://github.com/leomosley/syncthing";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen antialiased text-neutral-300">
    <header class="fixed inset-x-0 top-0 z-50 flex items-center justify-between px-5 py-4 sm:px-8">
      <a
        href="/"
        class="font-mono text-sm tracking-tight text-neutral-200 transition-opacity duration-200 hover:opacity-70"
      >
        syncthing
      </a>

      <nav class="flex items-center gap-5 text-sm">
        <a
          href="/docs"
          class={`transition-colors duration-200 hover:text-neutral-200 ${
            active === "docs" ? "text-neutral-200" : "text-neutral-500"
          }`}
        >
          Docs
        </a>
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.04] px-3.5 py-1.5 text-xs text-neutral-400 backdrop-blur-md transition-all duration-200 hover:border-white/[0.15] hover:text-neutral-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-3.5 w-3.5 shrink-0"
            aria-hidden="true"
          >
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
            ></path>
          </svg>
          GitHub
        </a>
      </nav>
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    <footer
      class="relative z-10 border-t border-white/[0.06] px-5 py-8 text-xs text-neutral-600 sm:px-8"
    >
      <div class="mx-auto flex max-w-3xl items-center justify-between">
        <span class="font-mono">syncthing</span>
        <a
          href="https://mosly.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-200 hover:text-neutral-400"
        >
          mosly.dev
        </a>
      </div>
    </footer>
  </body>
</html>
