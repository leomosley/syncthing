---
import Base from "../layouts/Base.astro";
import CopyCommand from "../components/CopyCommand.astro";

const features = [
  {
    title: "Git under the hood",
    body: "Changes are detected with git and stored in a private repo you own. No third-party servers.",
  },
  {
    title: "Push or pull, automatically",
    body: "A scheduled check commits local edits or fast-forwards remote ones on the interval you set.",
  },
  {
    title: "Runs everywhere",
    body: "One native scheduled task per folder on macOS, Linux and Windows. Zero resident processes.",
  },
];
---

<Base
  title="syncthng"
  description="A tiny CLI that keeps a directory in sync using GitHub as file storage and git for change detection."
  active="home"
>
  <section
    class="mx-auto flex max-w-3xl flex-col items-center px-5 pb-24 pt-36 text-center sm:pt-44"
  >
    <h1 class="max-w-2xl text-4xl font-light leading-[1.1] tracking-tight text-white sm:text-6xl">
      Keep any folder&nbsp;<span class="text-accent">in sync</span>.
    </h1>

    <p class="mt-6 max-w-md text-sm leading-relaxed text-neutral-500 sm:text-base">
      Point the CLI at a directory, set an interval, and it quietly pushes and pulls your changes on
      a schedule.
    </p>

    <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row">
      <CopyCommand command="npx syncthng init" />
      <a
        href="/docs"
        class="text-sm text-neutral-400 transition-colors duration-200 hover:text-accent"
      >
        Read the docs
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-28">
    <div
      class="grid gap-px overflow-hidden rounded-2xl border border-white/[0.06] bg-white/[0.03] sm:grid-cols-3"
    >
      {
        features.map((feature) => (
          <div class="bg-bg/40 p-6">
            <h2 class="mb-2 text-sm font-medium text-neutral-200">{feature.title}</h2>
            <p class="text-sm leading-relaxed text-neutral-500">{feature.body}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>
