---
import Base from "../layouts/Base.astro";
import CopyCommand from "../components/CopyCommand.astro";

const commands = [
  { cmd: "npx syncthing init", desc: "Set up a new folder to sync (interactive)." },
  { cmd: "npx syncthing sync [name]", desc: "Sync now. Omit the name to sync all folders." },
  { cmd: "npx syncthing list", desc: "List configured folders and their intervals." },
  { cmd: "npx syncthing status", desc: "Show the live git state for each folder." },
  { cmd: "npx syncthing remove [name]", desc: "Stop syncing a folder. Files are kept." },
  { cmd: "npx syncthing service repair", desc: "Re-register every scheduled task." },
  { cmd: "npx syncthing service uninstall", desc: "Remove every scheduled task." },
];

const requirements = [
  { name: "git", note: "Change detection and transport." },
  { name: "gh", note: "GitHub CLI, authenticated via gh auth login." },
  { name: "bun", note: "The runtime the CLI is built for." },
];

const steps = [
  { platform: "macOS", tech: "launchd", detail: "one LaunchAgent per folder" },
  { platform: "Linux", tech: "cron", detail: "one crontab entry per folder" },
  { platform: "Windows", tech: "schtasks", detail: "one scheduled task per folder" },
];
---

<Base
  title="syncthing docs"
  description="How to install and use syncthing, the folder sync CLI backed by GitHub."
  active="docs"
>
  <article class="mx-auto max-w-2xl px-5 pb-28 pt-32 sm:pt-40 [&_h2]:scroll-mt-24">
    <header class="mb-16">
      <h1 class="text-3xl font-light tracking-tight text-white">Docs</h1>
      <p class="mt-3 text-sm leading-relaxed text-neutral-500">
        syncthing keeps a directory in sync using a private GitHub repo as storage and git to decide
        when to push or pull. You work on one machine at a time; it handles the rest on a schedule.
      </p>
    </header>

    <section class="mb-14">
      <h2 class="mb-4 text-sm font-medium text-neutral-200">Requirements</h2>
      <dl class="space-y-3">
        {
          requirements.map((req) => (
            <div class="flex items-baseline gap-4">
              <dt class="w-12 shrink-0 font-mono text-sm text-accent">{req.name}</dt>
              <dd class="text-sm leading-relaxed text-neutral-500">{req.note}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mb-14">
      <h2 class="mb-4 text-sm font-medium text-neutral-200">Install</h2>
      <p class="mb-4 text-sm leading-relaxed text-neutral-500">
        Nothing to install. Run it with npx and npm fetches the latest version on demand.
      </p>
      <CopyCommand command="npx syncthing init" />
    </section>

    <section class="mb-14">
      <h2 class="mb-4 text-sm font-medium text-neutral-200">Quick start</h2>
      <p class="text-sm leading-relaxed text-neutral-500">
        Run init and follow the prompts. Browse to a folder, name the repo, choose visibility and an
        interval, and pick what to ignore.
      </p>
    </section>

    <section class="mb-14">
      <h2 class="mb-4 text-sm font-medium text-neutral-200">Commands</h2>
      <ul class="divide-y divide-white/[0.06] rounded-xl border border-white/[0.06]">
        {
          commands.map((command) => (
            <li class="px-4 py-3">
              <p class="font-mono text-sm text-accent">{command.cmd}</p>
              <p class="mt-1 text-sm text-neutral-500">{command.desc}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-14">
      <h2 class="mb-4 text-sm font-medium text-neutral-200">How it works</h2>
      <ol class="space-y-3 text-sm leading-relaxed text-neutral-500">
        <li>
          <span class="text-neutral-300">Commit.</span> Any local edits are staged and committed before
          comparing with the remote.
        </li>
        <li>
          <span class="text-neutral-300">Compare.</span> It fetches origin and reads how far ahead or
          behind the branch is.
        </li>
        <li>
          <span class="text-neutral-300">Move.</span> If the branch is behind, it fast-forwards a pull.
          If it is ahead, it pushes. If it has diverged, it rebases and pushes, aborting safely on conflict.
        </li>
      </ol>
    </section>

    <section class="mb-14">
      <h2 class="mb-4 text-sm font-medium text-neutral-200">Scheduling</h2>
      <p class="mb-5 text-sm leading-relaxed text-neutral-500">
        Each folder gets one short-lived native scheduled task at its own interval, with no
        background daemon holding memory.
      </p>
      <ul class="divide-y divide-white/[0.06] rounded-xl border border-white/[0.06]">
        {
          steps.map((step) => (
            <li class="flex items-baseline justify-between gap-4 px-4 py-3">
              <span class="text-sm text-neutral-200">{step.platform}</span>
              <span class="text-right text-sm text-neutral-500">
                <span class="font-mono text-neutral-400">{step.tech}</span>, {step.detail}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="mb-4 text-sm font-medium text-neutral-200">Config</h2>
      <p class="text-sm leading-relaxed text-neutral-500">
        Your folders live in <span class="font-mono text-neutral-300"
          >~/.config/syncthing/config.json</span
        > (<span class="font-mono text-neutral-300">%APPDATA%\syncthing</span> on Windows). Removing a
        folder unregisters its task but never touches your files.
      </p>
    </section>
  </article>
</Base>
