{
  "name": "syncthing",
  "version": "0.1.0",
  "description": "SyncThing a CLI for syncing directories using GitHub as file storage.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leomosley/syncthing.git"
  },
  "bin": {
    "syncthing": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --minify",
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "link": "bun run build && bun link",
    "unlink": "bun unlink",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
