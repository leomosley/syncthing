{
  "name": "syncthng",
  "version": "0.1.0",
  "description": "Syncthng a CLI for syncing directories using GitHub as file storage.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leomosley/syncthing.git"
  },
  "bin": {
    "syncthng": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --minify",
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "link": "bun run build && bun link",
    "unlink": "bun unlink",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
